{
  "name": "batch-rename",
  "version": "1.0.0",
  "description": "批量重命名工具 - 基于 Electron + React + TypeScript 的桌面应用程序",
  "main": "dist-electron/main.js",
  "type": "module",
  "author": "Developer",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:vite": "tsc && vite build",
    "build:win": "tsc && vite build && electron-builder --win",

    "package:win": "tsc && vite build && electron-packager . --platform=win32 --arch=x64 --out=release --overwrite --ignore=node_modules --ignore=test --ignore=.gitignore --ignore=.npmrc --ignore=.prettierrc --ignore=electron-builder.yml --ignore=eslint.config.js --ignore=postcss.config.js --ignore=tailwind.config.js --ignore=tsconfig.json --ignore=tsconfig.node.json --ignore=vitest.config.ts --ignore=installer.iss --ignore=installer-simple.iss --ignore=.trae --ignore=doc",






    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.25.0",
    "@eslint/js": "^9.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^15.0.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.33",
    "prettier": "^3.2.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.0.12",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^1.2.0"
  },
  "build": {
    "appId": "com.batch-rename.app",
    "productName": "批量重命名工具",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "批量重命名工具"
    }
  }
}
